# =========================================================
# DIVYADHARA — APPLICATION
# =========================================================

NODE_ENV=production

PORT=3001
HOST=0.0.0.0

API_VERSION=1.0.0
API_BODY_LIMIT=1mb


# =========================================================
# FRONTEND -> BACKEND API
# =========================================================

# Development:
# VITE_API_URL = /api

# Production:
VITE_API_URL=https://divya-dhara.in/api


# =========================================================
# APPLICATION URLS
# =========================================================

# APP_URL=http://localhost:5173
# FRONTEND_URL=http://localhost:5173
# BACKEND_URL=https://divya-dhara.in

# Production:
APP_URL=https://divya-dhara.in
FRONTEND_URL=https://divya-dhara.in
BACKEND_URL=https://divya-dhara.in

# =========================================================
# AUTHENTICATION
# =========================================================

AUTH_COOKIE_NAME=divyadhara_session

SESSION_DAYS=7
PASSWORD_RESET_MINUTES=30
VERIFICATION_TOKEN_MINUTES=30


# =========================================================
# SQLITE DATABASE
# =========================================================

DIVYADHARA_DB_PATH=./data/divyadhara.sqlite

# Optional absolute path:
# DIVYADHARA_DB_PATH=/var/lib/divyadhara/divyadhara.sqlite


# =========================================================
# SUPER ADMIN BOOTSTRAP
# =========================================================

SUPER_ADMIN_NAME="DivyaDhara Admin"
SUPER_ADMIN_EMAIL="dharadivya59@gmail.com"
SUPER_ADMIN_PASSWORD="Divya-Dhara@123"

SALES_NAME="DivyaDhara Sales"
SALES_EMAIL="gjh2733@gmail.com"
SALES_PASSWORD="Divya-Dhara@123"


# =========================================================
# PAYMENTS — APPLICATION LEVEL
# =========================================================

PAYMENTS_ENABLED=true
PAYMENT_PROVIDER=razorpay
PAYMENT_ENVIRONMENT=test
PAYMENT_CURRENCY=INR
PAYMENT_COMPANY_NAME=DivyaDhara


# =========================================================
# RAZORPAY
# =========================================================

RAZORPAY_MODE=test

RAZORPAY_KEY_ID=REPLACE_WITH_RAZORPAY_TEST_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_RAZORPAY_TEST_KEY_SECRET

RAZORPAY_MERCHANT_ID=REPLACE_IF_AVAILABLE

RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_RAZORPAY_WEBHOOK_SECRET

RAZORPAY_CURRENCY=INR
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1

RAZORPAY_CALLBACK_URL=https://divya-dhara.in/api/payment/callback

RAZORPAY_COMPANY_NAME=DivyaDhara

# Production:
# RAZORPAY_MODE=live
# PAYMENT_ENVIRONMENT=live
# RAZORPAY_CALLBACK_URL=https://divya-dhara.in/payment/callback


# =========================================================
# LEAD / CRM
# =========================================================

LEAD_DUPLICATE_HOURS=24

LEAD_RATE_LIMIT_WINDOW_MINUTES=5
LEAD_RATE_LIMIT_COUNT=8


# =========================================================
# ANALYTICS
# =========================================================

ANALYTICS_ENABLED=true
ANALYTICS_TRACK_ANONYMOUS=true
ANALYTICS_STORE_IP_HASH_ONLY=true
ANALYTICS_REQUIRE_CONSENT=false

ANALYTICS_IP_SALT=REPLACE_WITH_A_LONG_RANDOM_ANALYTICS_SALT

ANALYTICS_VISITOR_COOKIE=divyadhara_visitor
ANALYTICS_SESSION_COOKIE=divyadhara_analytics_session

ANALYTICS_SESSION_MINUTES=30
ANALYTICS_VISITOR_COOKIE_DAYS=730
ANALYTICS_MAX_EVENT_PAYLOAD=30000

ANALYTICS_RATE_LIMIT_WINDOW_MINUTES=1
ANALYTICS_RATE_LIMIT_COUNT=120


# =========================================================
# LEAD + ANALYTICS ATTRIBUTION
# =========================================================

LEAD_ATTRIBUTION_ENABLED=true

SEO_LOCATION_LEVELS=country,state,district,city,area


# =========================================================
# BUSINESS SETTINGS
# =========================================================

PANDIT_LEAD_ASSIGNMENT_MODE=subscription_quota


# =========================================================
# CRAWLER / CONTENT INGESTION
# =========================================================

JOB_LIMIT=999999

MIN_FILE_BYTES=20000

REQUEST_DELAY_MS=2500
DOWNLOAD_DELAY_MS=1500

MAX_RETRIES=2

INITIAL_BACKOFF_MS=4000
MAX_BACKOFF_MS=90000

PROVIDER_COOLDOWN_MS=900000

REQUEST_TIMEOUT_MS=20000
PAGE_TIMEOUT_MS=15000


# =========================================================
# SEARCH APIs
# =========================================================

GOOGLE_API_KEY=
GOOGLE_CX=b7dc9303538e845d1

BING_IMAGE_SEARCH_KEY=


# =========================================================
# YOUTUBE DATA API
# =========================================================
#
# SERVER-SIDE ONLY
# NEVER use VITE_YOUTUBE_API_KEY
#
# The previously exposed key should be rotated.
#

YOUTUBE_API_KEY=AIzaSyCqt-f99mTPCj9YmWLrvmYgEX--er__p0Y


# =========================================================
# AI / COMFYUI
# =========================================================

AI_FALLBACK=true

COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors

COMFYUI_WIDTH=1024
COMFYUI_HEIGHT=1024

COMFYUI_STEPS=28
COMFYUI_CFG=7

COMFYUI_SAMPLER=euler
COMFYUI_SCHEDULER=normal

COMFYUI_POLL_MS=2500
COMFYUI_MAX_WAIT_MS=600000


# =========================================================
# CORS
# =========================================================

# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:4173,http://127.0.0.1:4173,http://localhost:4174,http://127.0.0.1:4174

# Production:
CORS_ORIGINS=https://divya-dhara.in,https://www.divya-dhara.in


# =========================================================
# VIDEO MODE
# =========================================================

VIDEO_LISTING_MODE=all


# =========================================================
# SEO
# =========================================================

SEO_AUTO_GENERATE_LOCATION_PAGES=false
SEO_REQUIRE_UNIQUE_CONTENT=true


# =========================================================
# FEATURE FLAGS
# =========================================================

AUTH_ENABLED=true
LEADS_ENABLED=true
CRM_ENABLED=true
SEO_ENABLED=true
PAYMENTS_ENABLED=true
SUBSCRIPTIONS_ENABLED=true
YOUTUBE_ENABLED=true
VIDEOS_ENABLED=true


