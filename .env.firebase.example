# =========================================================
# DIVYADHARA — APPLICATION
# =========================================================

NODE_ENV=development

PORT=3001
HOST=0.0.0.0

API_VERSION=1.0.0
API_BODY_LIMIT=1mb


# =========================================================
# FRONTEND -> BACKEND API
# =========================================================
#
# Keep this as the backend origin.
# Frontend API clients can append /api where required.
#

VITE_API_URL=http://localhost:3001


# =========================================================
# APPLICATION URLS
# =========================================================

APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001

# Production example:
# APP_URL=https://divya-dhara.in
# FRONTEND_URL=https://divya-dhara.in
# BACKEND_URL=https://api.divya-dhara.in


# =========================================================
# AUTHENTICATION
# =========================================================

AUTH_COOKIE_NAME=divyadhara_session

# Session lifetime
SESSION_DAYS=7

# Password reset token lifetime
PASSWORD_RESET_MINUTES=30

# Email verification token lifetime
VERIFICATION_TOKEN_MINUTES=30


# =========================================================
# SQLITE DATABASE
# =========================================================

DIVYADHARA_DB_PATH=./data/divyadhara.sqlite

# Optional absolute path:
# DIVYADHARA_DB_PATH=/var/lib/divyadhara/divyadhara.sqlite


# =========================================================
# SUPER ADMIN BOOTSTRAP
# =========================================================
#
# Used by:
#
# npx tsx server/scripts/create-super-admin.ts
#
# IMPORTANT:
# Keep the real password only in your local/server .env.
# Never commit this file to Git.
#

SUPER_ADMIN_NAME="DivyaDhara Admin"
SUPER_ADMIN_EMAIL="dharadivya59@gmail.com"
SUPER_ADMIN_PASSWORD="Divya-Dhara@123"


# =========================================================
# PAYMENTS — APPLICATION LEVEL
# =========================================================
#
# Current architecture uses:
# Razorpay
# payments
# payment_orders
# payment_links
# payment_webhook_events
#

PAYMENTS_ENABLED=true

PAYMENT_PROVIDER=razorpay

# Allowed values used by application logic:
# test
# live
PAYMENT_ENVIRONMENT=test

PAYMENT_CURRENCY=INR

PAYMENT_COMPANY_NAME=DivyaDhara


# =========================================================
# RAZORPAY
# =========================================================
#
# NEVER expose:
# - RAZORPAY_KEY_SECRET
# - RAZORPAY_WEBHOOK_SECRET
# in frontend code.
#
# NEVER use VITE_RAZORPAY_KEY_SECRET.
#

RAZORPAY_MODE=test

RAZORPAY_KEY_ID=REPLACE_WITH_RAZORPAY_TEST_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_RAZORPAY_TEST_KEY_SECRET

RAZORPAY_MERCHANT_ID=REPLACE_IF_AVAILABLE

RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_RAZORPAY_WEBHOOK_SECRET

RAZORPAY_CURRENCY=INR

RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1

RAZORPAY_CALLBACK_URL=http://localhost:5173/payment/callback

RAZORPAY_COMPANY_NAME=DivyaDhara

# Production example:
# RAZORPAY_MODE=live
# PAYMENT_ENVIRONMENT=live
# RAZORPAY_CALLBACK_URL=https://divya-dhara.in/payment/callback


# =========================================================
# LEAD / CRM
# =========================================================
#
# Public forms supported:
# - general
# - contact
# - puja
# - pandit
# - temple
# - ashram
# - yatra
# - travel
# - event
# - course
#
# Leads keep:
# - form submission
# - visitor/session
# - source/referrer
# - UTM
# - Country
# - State
# - District
# - City
# - service/entity relationship
#

LEAD_DUPLICATE_HOURS=24

LEAD_RATE_LIMIT_WINDOW_MINUTES=5
LEAD_RATE_LIMIT_COUNT=8


# =========================================================
# ANALYTICS
# =========================================================
#
# Visitor -> Session -> Page View -> Event -> Conversion
#
# IP is hashed instead of storing raw IP.
#

ANALYTICS_ENABLED=true

ANALYTICS_TRACK_ANONYMOUS=true

ANALYTICS_STORE_IP_HASH_ONLY=true

ANALYTICS_REQUIRE_CONSENT=false

ANALYTICS_IP_SALT=REPLACE_WITH_A_LONG_RANDOM_ANALYTICS_SALT

ANALYTICS_VISITOR_COOKIE=divyadhara_visitor

ANALYTICS_SESSION_COOKIE=divyadhara_analytics_session

ANALYTICS_SESSION_MINUTES=30

ANALYTICS_VISITOR_COOKIE_DAYS=730

ANALYTICS_MAX_EVENT_PAYLOAD=30000

# Analytics API rate limiting
ANALYTICS_RATE_LIMIT_WINDOW_MINUTES=1
ANALYTICS_RATE_LIMIT_COUNT=120


# =========================================================
# LEAD + ANALYTICS ATTRIBUTION
# =========================================================
#
# Used for:
# Country / State / District / City / Area
# UTM
# referrer
# visitor
# session
# page attribution
#

LEAD_ATTRIBUTION_ENABLED=true

SEO_LOCATION_LEVELS=country,state,district,city,area


# =========================================================
# BUSINESS SETTINGS
# =========================================================

PANDIT_LEAD_ASSIGNMENT_MODE=subscription_quota

# Billable lead logic:
# A lead becomes billable to a Pandit when it is assigned
# and an active subscription credit is consumed.


# =========================================================
# CRAWLER / CONTENT INGESTION
# =========================================================

JOB_LIMIT=999999

MIN_FILE_BYTES=20000

REQUEST_DELAY_MS=2500

DOWNLOAD_DELAY_MS=1500

MAX_RETRIES=2

INITIAL_BACKOFF_MS=4000

MAX_BACKOFF_MS=90000

PROVIDER_COOLDOWN_MS=900000

REQUEST_TIMEOUT_MS=20000

PAGE_TIMEOUT_MS=15000


# =========================================================
# SEARCH APIs
# =========================================================

# Google Custom Search API
GOOGLE_API_KEY=

# Google Programmable Search Engine ID
GOOGLE_CX=b7dc9303538e845d1

# Bing Image Search
BING_IMAGE_SEARCH_KEY=


# =========================================================
# YOUTUBE DATA API
# =========================================================
#
# IMPORTANT:
# Server-side only.
#
# NEVER:
# VITE_YOUTUBE_API_KEY
#
# Rotate the key that was previously exposed and paste the
# new key here.
#

YOUTUBE_API_KEY=AIzaSyCqt-f99mTPCj9YmWLrvmYgEX--er__p0Y


# =========================================================
# AI / COMFYUI
# =========================================================

AI_FALLBACK=true

COMFYUI_URL=http://127.0.0.1:8188

COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors

COMFYUI_WIDTH=1024

COMFYUI_HEIGHT=1024

COMFYUI_STEPS=28

COMFYUI_CFG=7

COMFYUI_SAMPLER=euler

COMFYUI_SCHEDULER=normal

COMFYUI_POLL_MS=2500

COMFYUI_MAX_WAIT_MS=600000


# =========================================================
# CORS
# =========================================================
#
# Development origins
#

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:4173,http://127.0.0.1:4173,http://localhost:4174,http://127.0.0.1:4174


# =========================================================
# PRODUCTION CORS
# =========================================================
#
# Replace CORS_ORIGINS in production with only real domains.
#
# Example:
#
# CORS_ORIGINS=https://divya-dhara.in,https://www.divya-dhara.in
#
# API:
#
# VITE_API_URL=https://api.divya-dhara.in
# APP_URL=https://divya-dhara.in
# FRONTEND_URL=https://divya-dhara.in
# BACKEND_URL=https://api.divya-dhara.in
#


# =========================================================
# VIDEO MODE
# =========================================================
#
# Requirement:
# Videos page should be only "All Videos".
# No category-tab requirement.
#

VIDEO_LISTING_MODE=all


# =========================================================
# SEO
# =========================================================

SEO_AUTO_GENERATE_LOCATION_PAGES=false

SEO_REQUIRE_UNIQUE_CONTENT=true


# =========================================================
# FEATURE FLAGS
# =========================================================

AUTH_ENABLED=true

LEADS_ENABLED=true

ANALYTICS_ENABLED=true

CRM_ENABLED=true

SEO_ENABLED=true

PAYMENTS_ENABLED=true

SUBSCRIPTIONS_ENABLED=true

YOUTUBE_ENABLED=true

VIDEOS_ENABLED=true

AI_FALLBACK=true


# =========================================================
# SECURITY / APPLICATION NOTES
# =========================================================
#
# Production:
# 1. NODE_ENV=production
# 2. Use HTTPS
# 3. Use Secure cookies
# 4. Use strong random ANALYTICS_IP_SALT
# 5. Use live Razorpay credentials only on server
# 6. Restrict CORS
# 7. Never commit .env
#
# =========================================================

# =========================================================
# DivyaDhara Phase 2 — Firebase Web Authentication
# =========================================================
# These VITE_* values are client configuration values supplied
# by Firebase Console > Project settings > Your apps > Web app.
# They are NOT service-account secrets.

VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_web_app_id

# =========================================================
# DivyaDhara Phase 2 — Firebase Admin SDK
# =========================================================
# NEVER expose these as VITE_* variables.
# NEVER commit the service-account private key.

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nYOUR_PRIVATE_KEY\\n-----END PRIVATE KEY-----\\n"
