# =========================================================
# DivyaDhara — Production ROOT .htaccess
# =========================================================
#
# Document root:
#   /home/hbqzcgk45gct/divya-dhara.in
#
# Frontend:
#   /dist
#
# API:
#   /api/*
#   Handled by Node/Express + Passenger/cPanel Application Manager.
#
# IMPORTANT:
#   This file does NOT proxy /api to Node by itself.
#   Passenger/Node must be configured in cPanel.
# =========================================================

Options -Indexes
Options -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On

    # =====================================================
    # 1. FORCE HTTPS
    # =====================================================

    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # =====================================================
    # 2. CANONICAL HOST
    # =====================================================
    #
    # Choose ONE canonical host.
    # DivyaDhara is currently using:
    #   https://divya-dhara.in
    #
    # Uncomment this block only if you want to force
    # www -> non-www.
    #
    # RewriteCond %{HTTP_HOST} ^www\.divya-dhara\.in$ [NC]
    # RewriteRule ^ https://divya-dhara.in%{REQUEST_URI} [R=301,L]
    #
    # =====================================================


    # =====================================================
    # 3. PROTECT ENVIRONMENT / CONFIG / SOURCE FILES
    # =====================================================

    # .env and variants
    RewriteRule ^\.env(?:\..*)?$ - [F,L,NC]

    # Git
    RewriteRule ^\.git(?:/|$) - [F,L,NC]
    RewriteRule ^\.gitignore$ - [F,L,NC]

    # Node dependencies
    RewriteRule ^node_modules(?:/|$) - [F,L,NC]

    # Source / backend
    RewriteRule ^server(?:/|$) - [F,L,NC]
    RewriteRule ^src(?:/|$) - [F,L,NC]
    RewriteRule ^coverage(?:/|$) - [F,L,NC]
    RewriteRule ^scripts(?:/|$) - [F,L,NC]
    RewriteRule ^tests?(?:/|$) - [F,L,NC]

    # Project / build configuration
    RewriteRule ^(?:package\.json|package-lock\.json|pnpm-lock\.yaml|yarn\.lock)$ - [F,L,NC]
    RewriteRule ^(?:tsconfig(?:\..*)?|vite\.config\..*|eslint\.config\..*)$ - [F,L,NC]

    # Database files
    RewriteRule ^data(?:/|$) - [F,L,NC]
    RewriteRule \.(?:db|sqlite|sqlite3|db-shm|db-wal)$ - [F,L,NC]

    # Logs / temporary files
    RewriteRule \.(?:log|bak|backup|tmp|temp|old|orig|swp)$ - [F,L,NC]

    # Lock / deployment files that should never be public
    RewriteRule ^(?:\.user\.ini|composer\.(?:json|lock)|Dockerfile|docker-compose\.ya?ml)$ - [F,L,NC]


    # =====================================================
    # 4. BLOCK HIDDEN FILES / DIRECTORY METADATA
    # =====================================================

    # Block hidden files/directories except .well-known
    RewriteRule (^|/)\.(?!well-known(?:/|$))[^/]+ - [F,L,NC]


    # =====================================================
    # 5. API — DO NOT SEND INTO React / DIST
    # =====================================================
    #
    # IMPORTANT:
    # /api/* must remain available for Passenger/Node.
    #
    # This rule does NOT create the proxy.
    # cPanel Node.js Application / Passenger must handle it.
    #

    RewriteRule ^api(?:/|$) - [END,NC]


    # =====================================================
    # 6. PASS THROUGH REAL DIST PATHS
    # =====================================================
    #
    # Prevent:
    #   /dist/...
    # becoming:
    #   /dist/dist/...
    #

    RewriteRule ^dist(?:/|$) - [END,NC]


    # =====================================================
    # 7. PASS THROUGH REAL STATIC FILES AT ROOT
    # =====================================================
    #
    # Useful for:
    #   favicon.ico
    #   robots.txt
    #   sitemap.xml
    #   site.webmanifest
    #   verification files
    #

    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [END]


    # =====================================================
    # 8. ROOT STATIC FILES -> DIST
    # =====================================================
    #
    # Example:
    #   /favicon.ico
    #   -> /dist/favicon.ico
    #
    #   /assets/app.js
    #   -> /dist/assets/app.js
    #

    RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f
    RewriteRule ^(.+)$ dist/$1 [END]


    # =====================================================
    # 9. REACT / VITE SPA FALLBACK
    # =====================================================
    #
    # All frontend routes:
    #
    #   /
    #   /temples
    #   /pandits
    #   /ashrams
    #   /login
    #   /dashboard
    #   /admin/dashboard
    #
    # go to:
    #
    #   /dist/index.html
    #

    RewriteRule ^$ dist/index.html [END]
    RewriteRule ^.*$ dist/index.html [END]

</IfModule>


# =========================================================
# 10. SECURITY HEADERS
# =========================================================

<IfModule mod_headers.c>

    # Prevent MIME sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Prevent clickjacking from other origins
    Header always set X-Frame-Options "SAMEORIGIN"

    # Referrer privacy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Browser feature restrictions
    Header always set Permissions-Policy "geolocation=(self), microphone=(), camera=(), payment=(self)"

    # Disable legacy caching of error responses where supported
    Header always set X-Permitted-Cross-Domain-Policies "none"

</IfModule>


# =========================================================
# 11. HSTS
# =========================================================
#
# ONLY enable this when HTTPS is permanently configured.
#
# max-age = 1 year
#
# Do NOT add preload until domain/subdomain HTTPS behavior
# has been completely verified.
#

<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>


# =========================================================
# 12. CACHE CONTROL — STATIC ASSETS
# =========================================================

<IfModule mod_expires.c>

    ExpiresActive On

    # Images
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Fonts
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"

    # CSS / JS
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    # Manifest
    ExpiresByType application/manifest+json "access plus 1 month"

</IfModule>


# =========================================================
# 13. IMMUTABLE CACHE FOR VITE-HASHED ASSETS
# =========================================================
#
# Vite normally generates:
#   app-AbCd1234.js
#   index-XyZ987.css
#
# These can safely be cached aggressively.

<IfModule mod_headers.c>

    <FilesMatch "\.(?:js|mjs|css|woff|woff2|png|jpg|jpeg|gif|webp|avif|svg|ico)$">
        Header append Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

</IfModule>


# =========================================================
# 14. HTML SHOULD NOT BE CACHED LONG-TERM
# =========================================================

<IfModule mod_headers.c>

    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

</IfModule>


# =========================================================
# 15. COMPRESSION
# =========================================================

<IfModule mod_deflate.c>

    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE image/svg+xml

    # Avoid compressing already-compressed formats
    SetEnvIfNoCase Request_URI "\.(?:gif|jpe?g|png|webp|avif|zip|gz|br|woff2)$" no-gzip dont-vary

</IfModule>


# =========================================================
# 16. VARY HEADER FOR COMPRESSION
# =========================================================

<IfModule mod_headers.c>
    Header append Vary Accept-Encoding
</IfModule>


# =========================================================
# 17. BASIC MIME TYPES
# =========================================================

<IfModule mod_mime.c>

    AddType application/javascript .js
    AddType application/javascript .mjs
    AddType application/json .json

    AddType font/woff .woff
    AddType font/woff2 .woff2

    AddType image/avif .avif
    AddType image/webp .webp

</IfModule>